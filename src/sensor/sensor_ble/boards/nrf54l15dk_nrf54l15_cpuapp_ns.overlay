/ {
	dht11: dht11 {
		compatible = "aosong,dht";
		status = "okay";
		dio-gpios = <&gpio1 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};

	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>;
	};

	leds {
		compatible = "gpio-leds";

		led_active: led-active {
			gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
			label = "Active status LED";
		};
	};

	buttons {
		compatible = "gpio-keys";

		reset_btn: reset-btn {
			gpios = <&gpio1 12 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
			label = "Reset button";
		};
	};

	periph_pwr: periph-pwr {
		compatible = "regulator-fixed";
		regulator-name = "Peripheral power regulator";
		enable-gpios = <&gpio1 10 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		regulator-boot-off;
		startup-delay-us = <0>;
		off-on-delay-us = <0>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN4>; /* P1.11 */
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN2>; /* P1.06 */
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};
};
